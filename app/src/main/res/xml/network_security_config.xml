<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS: el tráfico sin cifrar (http://) está bloqueado en toda la app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
