<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: la app no se incluye en copias de seguridad en la nube ni en la transferencia a otro teléfono
    (coincide con allowBackup="false"). La carpeta privada está cifrada con claves que no salen del teléfono,
    así que copiarla no serviría y solo expondría datos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
