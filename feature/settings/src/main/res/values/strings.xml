    <!-- Aviso legal -->
    <string name="settings_legal_use">Solo debes descargar contenido propio, de dominio público, con una licencia que lo permita (por ejemplo, Creative Commons) o con autorización del titular de los derechos.</string>
    <string name="settings_legal_responsibility">Eres responsable del uso que hagas de la app y del contenido que descargues.</string>
    <string name="settings_legal_drm">%1$s no descarga ni intenta saltarse contenido protegido con DRM (por ejemplo, Widevine) ni otras medidas técnicas de protección, bajo ninguna circunstancia.</string>
    <string name="settings_legal_blocklist">Para atender solicitudes de retiro (DMCA o equivalentes), la app incluye una lista de sitios bloqueados que se puede actualizar desde GitHub.</string>
    <string name="settings_legal_contact_title">Reclamos de derechos de autor</string>
    <string name="settings_legal_contact_message">Si eres titular de derechos y quieres que se bloquee un sitio, escribe a:</string>
    <string name="settings_legal_contact_action">Abrir mi app de correo</string>

    <!-- Privacidad -->
    <string name="settings_privacy_summary">LibreDescarga no recoge, no envía y no vende datos personales. Todo se guarda en tu teléfono. Las donaciones se procesan directamente en PayPal, fuera de la app.</string>
    <string name="settings_privacy_connections_title">Conexiones a internet</string>
    <string name="settings_privacy_connections_intro">La app solo se conecta cuando tú lo pides:</string>
    <string name="settings_privacy_sites">• A los sitios cuyo video o audio analizas, descargas o visitas en el navegador, y al servicio que muestra sus miniaturas.</string>
    <string name="settings_privacy_github">• A GitHub, solo al buscar actualizaciones de la app, del motor yt-dlp o de la lista de sitios bloqueados.</string>
    <string name="settings_privacy_search">• A DuckDuckGo, solo si buscas palabras en el navegador integrado.</string>
    <string name="settings_privacy_never_title">Lo que nunca hace</string>
    <string name="settings_privacy_never">No tiene anuncios, analíticas, informes automáticos de errores, cuentas ni identificadores publicitarios. Los reportes de error, si quieres enviar uno, se hacen a mano y son opcionales.</string>

